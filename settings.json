{
   "latex-workshop.latex.autoBuild.run": "onSave",
   "latex-workshop.latex.outDir": "%DIR%/build",
   "latex-workshop.latex.recipes": [
       {
           "name": "XeLaTeX MK",
           "tools": [
               "xelatexmk",
               "move_pdf"
           ]
       }
   ],
   "latex-workshop.latex.tools": [
       {
           "name": "xelatexmk",
           "command": "latexmk",
           "args": [
               "-xelatex",
               "-synctex=1",
               "-interaction=nonstopmode",
               "-file-line-error",
               "-outdir=%OUTDIR%",
               "%DOC%"
           ],
           "env": {}
       },
       {
           "name": "move_pdf",
           "command": "cmd",
           "args": [
               "/c",
               "copy",
               "/Y",
               "%DIR%\\build\\%DOCFILE%.pdf",
               "%DIR%\\%DOCFILE%.pdf"
           ]
       }
   ],
   "editor": {
       "suggest.showWords": false,
       "wordWrap": "on",
       "lineHeight": 28,
       "fontSize": 16,
       "wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
       "occurrencesHighlight": false,
       "selectionHighlight": false,
       "matchBrackets": false
   },
   "github.copilot.enable": {
       "*": false
   },
   "editor.suggest.showWords": false,
   "ltex.disabledRules": {
       "en": [ "PHRASE_REPETITION", "ENGLISH_WORD_REPEAT_BEGINNING_RULE" ],
       "en-US": [ "PHRASE_REPETITION", "ENGLISH_WORD_REPEAT_BEGINNING_RULE" ]
   },
   "editor.matchBrackets": "never",
   "editor.occurrencesHighlight": "off",
   "editor.minimap.enabled": false,
   "files.exclude": {
       "**/build": true
   }
}